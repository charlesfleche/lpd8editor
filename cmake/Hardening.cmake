# Hardening flags for everything we build, as distributions use for their
# packages (Debian's dpkg-buildflags, Fedora's redhat-rpm-config). They turn
# some memory errors into a clean abort instead of something an attacker
# can use, at a negligible cost. The 'hardening' test checks the result in
# the binary (cmake/CheckHardening.cmake).
#
# Like the sanitizers, they apply to the whole build: the code generated by
# moc, uic and rcc too.

option(LPD8EDITOR_HARDENING "Build with hardening flags" ON)

if (NOT LPD8EDITOR_HARDENING)
    function(lpd8editor_add_hardening_test _target)
    endfunction()
    return()
endif()

add_compile_options(
    # Stack canaries in functions with arrays or address-taken locals.
    -fstack-protector-strong
    # Large stack allocations can't jump over the guard page.
    -fstack-clash-protection
    # Bounds checks in the standard library: std::array and std::vector's
    # operator[], std::optional's operator*... abort when out of range.
    -D_GLIBCXX_ASSERTIONS
)

# Control-flow protection (Intel CET: indirect branch tracking and shadow
# stack), or its Arm equivalent (pointer authentication, branch targets).
# On x86 it only takes effect if every object of the process is marked for
# it. Debian trixie's are not (glibc's start files, Qt), so the test doesn't
# check it: our code is ready for when the distribution is.
if (CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|i.86)$")
    add_compile_options(-fcf-protection=full)
elseif (CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
    add_compile_options(-mbranch-protection=standard)
endif()

# Locals start zeroed: an uninitialized read gets 0, not old data. Not in
# debug builds, where valgrind (the valgrind preset) must still see such a
# read as uninitialized to report it.
add_compile_options("$<$<NOT:$<CONFIG:Debug>>:-ftrivial-auto-var-init=zero>")

# Checked versions of memcpy, strcpy, printf... where the size is known at
# compile time. It needs optimization (glibc warns without, and the warning
# is an error with CMAKE_COMPILE_WARNING_AS_ERROR), and it doesn't mix with
# the sanitizers. -U first: some compilers (Ubuntu's) already define it.
if (NOT LPD8EDITOR_SANITIZERS AND NOT LPD8EDITOR_FUZZ)
    add_compile_options(
        "$<$<NOT:$<CONFIG:Debug>>:-U_FORTIFY_SOURCE>"
        "$<$<NOT:$<CONFIG:Debug>>:-D_FORTIFY_SOURCE=3>"
    )
endif()

# Position-independent executables, so that address space layout
# randomization applies to the program too, not only to the libraries.
include(CheckPIESupported)
check_pie_supported()
set(CMAKE_POSITION_INDEPENDENT_CODE ON)

add_link_options(
    # Full RELRO: the relocations are resolved at start-up, then made
    # read-only, so the GOT can't be overwritten.
    -Wl,-z,relro
    -Wl,-z,now
    # The stack is never executable.
    -Wl,-z,noexecstack
)

# The 'hardening' test checks a binary: call this after include(CTest).
function(lpd8editor_add_hardening_test _target)
    if (NOT LPD8EDITOR_HARDENING)
        return()
    endif()
    # The same condition as the flag above.
    set(_expect_fortify "$<NOT:$<CONFIG:Debug>>")
    if (LPD8EDITOR_SANITIZERS OR LPD8EDITOR_FUZZ)
        set(_expect_fortify 0)
    endif()
    add_test(
        NAME hardening
        COMMAND ${CMAKE_COMMAND}
            -DREADELF=${CMAKE_READELF}
            -DBINARY=$<TARGET_FILE:${_target}>
            -DEXPECT_FORTIFY=${_expect_fortify}
            -P ${PROJECT_SOURCE_DIR}/cmake/CheckHardening.cmake
    )
endfunction()
