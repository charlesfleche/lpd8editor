<component type="desktop-application">
  <id>io.github.charlesfleche.lpd8editor</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>lpd8editor</name>
  <summary>Edit the programs of an Akai LPD8 pad controller</summary>
  <developer id="io.github.charlesfleche">
    <name>Charles Flèche</name>
  </developer>

  <description>
    <p>
      lpd8editor edits the programs of the original Akai LPD8 pad
      controller: the note, program change and control change of each pad,
      whether a pad toggles, and the control change and range of each knob.
    </p>
    <ul>
      <li>Keep any number of programs, with undo and redo</li>
      <li>Get a program from the LPD8, or send one to any of its four slots</li>
      <li>Import and export programs as files</li>
    </ul>
    <p>
      It talks to the device over MIDI (the ALSA sequencer, which PipeWire and
      JACK also reach). The LPD8 Mk2 and the LPD8 Wireless are not supported.
    </p>
  </description>

  <launchable type="desktop-id">io.github.charlesfleche.lpd8editor.desktop</launchable>
  <provides>
    <binary>lpd8editor</binary>
  </provides>

  <url type="homepage">https://github.com/charlesfleche/lpd8editor</url>
