# Basic whitespace rules that most editors understand (https://editorconfig.org).
# C++ formatting details are in .clang-format.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Two trailing spaces mean a line break in Markdown.
trim_trailing_whitespace = false
